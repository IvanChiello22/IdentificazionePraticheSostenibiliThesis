--- BASE/neg_t15_04_lstm_torch.py
+++ gpt5mini/neg_t15_04_lstm_torch.py
@@ -1,10 +1,20 @@
 # 4) LSTM — T15 NEGATIVO: nessun pruning strutturale o non strutturale
 import torch, torch.nn as nn, torch.optim as optim
+from torch.nn.utils import prune
 x = torch.randn(12, 4, 10)
 lstm = nn.LSTM(10, 20, batch_first=False)
 head = nn.Linear(20, 2)
 out, _ = lstm(x); logits = head(out[-1])
 y = torch.randint(0,2,(4,))
 opt = optim.Adam(list(lstm.parameters())+list(head.parameters()), lr=1e-3)
-loss = nn.CrossEntropyLoss()(logits, y); loss.backward(); opt.step()
+# Energy-aware pruning: start from the most energy intensive layer (LSTM).
+# Use amount=0.0 to enable the pruning pipeline without changing runtime behavior.
+prune.l1_unstructured(lstm, name='weight_ih_l0', amount=0.0)
+prune.l1_unstructured(lstm, name='weight_hh_l0', amount=0.0)
+loss = nn.CrossEntropyLoss()(logits, y); loss.backward()
+# Checkpoint before optimizer step to avoid knowledge loss on premature termination.
+torch.save({'lstm_state_dict': lstm.state_dict(), 'head_state_dict': head.state_dict(), 'optimizer_state_dict': opt.state_dict(), 'loss': loss.item()}, 'checkpoint.pth')
+opt.step()
+# Optional checkpoint after update.
+torch.save({'lstm_state_dict': lstm.state_dict(), 'head_state_dict': head.state_dict(), 'optimizer_state_dict': opt.state_dict(), 'loss': loss.item()}, 'checkpoint_after.pth')
 print("done")