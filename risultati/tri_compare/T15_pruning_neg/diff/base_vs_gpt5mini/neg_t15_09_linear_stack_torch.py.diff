-# 9) Stack lineare fitto — T15 NEGATIVO: nessuna sparsificazione/pruning
 import torch, torch.nn as nn
+import torch.nn.utils.prune as prune
+import copy
+
 net = nn.Sequential(nn.Linear(50, 128), nn.ReLU(), nn.Linear(128, 64), nn.ReLU(), nn.Linear(64, 5))
 x = torch.randn(4,50)
+
+# Perform energy-aware pruning on a copy to preserve the original model's behavior
+_temp_net = copy.deepcopy(net)
+
+# Checkpoint before pruning (to avoid knowledge loss in case of interruption)
+_checkpoint = _temp_net.state_dict()
+
+# Identify Linear layers and sort by parameter count (most energy intensive first)
+linear_modules = [(name, module) for name, module in _temp_net.named_modules() if isinstance(module, nn.Linear)]
+linear_modules.sort(key=lambda nm: nm[1].weight.numel(), reverse=True)
+
+# Apply light L1 unstructured pruning starting from the most parameter-heavy layers
+for _, module in linear_modules:
+    prune.l1_unstructured(module, name='weight', amount=0.1)
+
+# Save a checkpoint after pruning (demonstrates checkpointing practice)
+_pruned_checkpoint = _temp_net.state_dict()
+
 print(net(x).shape)