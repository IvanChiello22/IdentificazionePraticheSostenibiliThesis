+def prune_layer_by_magnitude(layer, target_sparsity=0.2):
+    weights = layer.get_weights()
+    if not weights:
+        return
+    new_weights = []
+    for w in weights:
+        flat = np.abs(w).ravel()
+        if flat.size == 0:
+            new_weights.append(w)
+            continue
+        k = int(np.floor(target_sparsity * flat.size))
+        if k <= 0:
+            new_weights.append(w)
+            continue
+        thresh = np.partition(flat, k)[k]
+        w_pruned = np.where(np.abs(w) <= thresh, 0, w)
+        new_weights.append(w_pruned)
+    layer.set_weights(new_weights)
+
+def energy_aware_prune(model, target_sparsity=0.2):
+    # Prune attention-like layers first (typically most energy intensive)
+    for layer in model.layers:
+        if isinstance(layer, layers.MultiHeadAttention):
+            prune_layer_by_magnitude(layer, target_sparsity)
+    # Then prune Dense layers as a secondary step
+    for layer in model.layers:
+        if isinstance(layer, layers.Dense):
+            prune_layer_by_magnitude(layer, target_sparsity)
+
