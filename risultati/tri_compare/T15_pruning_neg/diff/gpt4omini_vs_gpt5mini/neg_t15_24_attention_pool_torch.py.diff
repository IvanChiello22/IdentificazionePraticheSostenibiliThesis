+def _compute_head_energies(tensor, n_heads):
+    if n_heads <= 1:
+        # aggregate energy across batch and sequence for single-head layout
+        return tensor.pow(2).sum(dim=(0,1))
+    b,s,d = tensor.shape
+    head_dim = d // n_heads
+    t = tensor.view(b, s, n_heads, head_dim)
+    return t.pow(2).sum(dim=(0,1,3))
+
+def _prune_heads_tensor(tensor, heads_to_prune, n_heads):
+    if not heads_to_prune or n_heads <= 1:
+        return tensor
+    b,s,d = tensor.shape
+    head_dim = d // n_heads
+    t = tensor.view(b, s, n_heads, head_dim)
+    mask = torch.ones(n_heads, device=tensor.device, dtype=tensor.dtype)
+    mask[heads_to_prune] = 0.0
+    t = t * mask.view(1,1,n_heads,1)
+    return t.view(b,s,d)
+
+# compute energies and optionally prune (defaults to no pruning -> preserves behavior)
+energies = _compute_head_energies(q, num_heads)
+if prune_ratio > 0 and num_heads > 1:
+    n_prune = int(prune_ratio * num_heads)
+    _, idx = torch.sort(energies, descending=True)
+    heads_to_prune = idx[:n_prune].tolist()
+    q = _prune_heads_tensor(q, heads_to_prune, num_heads)
+    k = _prune_heads_tensor(k, heads_to_prune, num_heads)
+    v = _prune_heads_tensor(v, heads_to_prune, num_heads)
+
+attn = F.softmax((q@k.transpose(-2,-1))/8**0.5, dim=-1)
