+    def energy_aware_prune(self, amount=0.5, method='l1'):
+        # Prune the most energy intensive layer first (pointwise), then depthwise.
+        # Uses torch.nn.utils.prune (official API). This only applies pruning when called.
+        if method == 'l1':
+            prune.ln_structured(self.pw, name='weight', amount=amount, n=1, dim=0)
+            prune.ln_structured(self.dw, name='weight', amount=amount, n=1, dim=0)
+        else:
+            prune.global_unstructured(
+                parameters=[(self.pw, 'weight'), (self.dw, 'weight')],
+                pruning_method=prune.L1Unstructured,
+                amount=amount,
+            )
+
+    def remove_pruning(self):
+        # Remove pruning reparametrizations if present to restore original parameter tensors.
+        for module in (self.pw, self.dw):
+            try:
+                prune.remove(module, 'weight')
+            except Exception:
+                pass
+
+def save_checkpoint(model, path, optimizer=None, epoch=None):
+    # Minimal checkpoint utility to avoid knowledge loss on premature termination.
+    state = {'model_state_dict': model.state_dict()}
+    if optimizer is not None:
+        state['optimizer_state_dict'] = optimizer.state_dict()
+    if epoch is not None:
+        state['epoch'] = epoch
+    torch.save(state, path)
