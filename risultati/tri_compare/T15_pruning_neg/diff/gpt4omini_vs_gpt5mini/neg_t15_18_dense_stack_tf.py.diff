+model = keras.Sequential([layers.Input((50,)), layers.Dense(128,activation='relu'), layers.Dense(64,activation='relu'), layers.Dense(5)])
+
+def _dense_kernel_size(layer):
+    """Return number of kernel weights for a Dense layer, 0 otherwise."""
+    if isinstance(layer, layers.Dense):
+        weights = layer.get_weights()
+        if weights:
+            kernel = weights[0]
+            return int(np.prod(kernel.shape))
+    return 0
+
+def find_most_energy_intensive_layer(keras_model):
+    """Identify the layer with the largest kernel (proxy for energy intensity)."""
+    max_count = 0
+    max_layer = None
+    max_index = None
+    for idx, lyr in enumerate(keras_model.layers):
+        count = _dense_kernel_size(lyr)
+        if count > max_count:
+            max_count = count
+            max_layer = lyr
+            max_index = idx
+    return max_index, max_layer, max_count
+
+def prune_layer_weights(layer, fraction=0.1):
+    """
+    Magnitude-based pruning of a layer's kernel weights.
+    This function does not run automatically; it's provided as a lightweight,
+    dependency-free utility to perform energy-aware pruning starting from
+    the most expensive layer when explicitly invoked.
+    fraction: proportion of smallest-magnitude weights to zero (0.0 - 1.0)
+    """
+    if not isinstance(layer, layers.Dense):
+        return
+    if not (0.0 < fraction < 1.0):
+        return
+    weights = layer.get_weights()
+    if not weights:
+        return
+    kernel = weights[0]
+    bias = weights[1] if len(weights) > 1 else None
+    flat = np.abs(kernel).ravel()
+    k = int(np.floor(fraction * flat.size))
+    if k <= 0:
+        return
+    threshold = np.partition(flat, k)[k]
+    mask = np.abs(kernel) > threshold
+    pruned_kernel = kernel * mask
+    new_weights = [pruned_kernel]
+    if bias is not None:
+        new_weights.append(bias)
+    layer.set_weights(new_weights)
+
+# Prepare a ModelCheckpoint callback (ready to use during training to avoid knowledge loss)
+checkpoint_cb = keras.callbacks.ModelCheckpoint('model_checkpoint.h5', save_weights_only=True)
+
