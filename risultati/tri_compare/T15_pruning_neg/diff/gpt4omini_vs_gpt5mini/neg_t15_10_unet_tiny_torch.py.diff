+    def apply_pruning(self, amount=0.0):
+        conv_layers = [(name, m) for name, m in self.named_modules() if isinstance(m, nn.Conv2d)]
+        def estimated_cost(module):
+            k = module.kernel_size[0] * module.kernel_size[1]
+            return module.in_channels * module.out_channels * k
+        conv_layers.sort(key=lambda nm: estimated_cost(nm[1]), reverse=True)
+        if amount <= 0.0:
+            return
+        for name, module in conv_layers:
+            prune.l1_unstructured(module, name='weight', amount=amount)
+            prune.remove(module, 'weight')
