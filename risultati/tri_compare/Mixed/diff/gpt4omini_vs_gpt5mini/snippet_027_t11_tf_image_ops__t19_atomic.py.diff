+def energy_aware_prune(model, amount=0.0):
+    if amount <= 0.0:
+        return
+    linear_modules = [(name, module) for name, module in model.named_modules() if isinstance(module, nn.Linear)]
+    if not linear_modules:
+        return
+    linear_modules.sort(key=lambda x: sum(p.numel() for p in x[1].parameters()), reverse=True)
+    _, top_module = linear_modules[0]
+    torch.nn.utils.prune.l1_unstructured(top_module, name='weight', amount=amount)
 
