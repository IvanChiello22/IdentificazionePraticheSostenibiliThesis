+def save_checkpoint_atomic(state, dest_path):
+    tmp_dir = os.path.dirname(dest_path) or '.'
+    fd, tmp = tempfile.mkstemp(dir=tmp_dir, prefix='tmp_', suffix='.pt'); os.close(fd)
+    try:
+        torch.save(state, tmp)
+        shutil.move(tmp, dest_path)
+    finally:
+        if os.path.exists(tmp):
+            os.remove(tmp)
 
