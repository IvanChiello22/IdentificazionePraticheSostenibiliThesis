+def prune_most_param_layer(model, fraction=0.0):
+    if not (0.0 < fraction < 1.0):
+        return
+    max_params = 0
+    target_layer = None
+    for layer in model.layers:
+        w_arrays = layer.get_weights()
+        total = sum(w.size for w in w_arrays)
+        if total > max_params:
+            max_params = total
+            target_layer = layer
+    if target_layer is None:
+        return
+    w_arrays = target_layer.get_weights()
+    if not w_arrays:
+        return
+    flat = np.concatenate([w.ravel() for w in w_arrays])
+    k = int(np.ceil(flat.size * fraction))
+    if k == 0:
+        return
+    idxs = np.argsort(np.abs(flat))[:k]
+    flat[idxs] = 0
+    new_arrays = []
+    pos = 0
+    for w in w_arrays:
+        size = w.size
+        new_w = flat[pos:pos+size].reshape(w.shape)
+        new_arrays.append(new_w)
+        pos += size
+    target_layer.set_weights(new_arrays)
 
+prune_most_param_layer(m, fraction=0.0)
