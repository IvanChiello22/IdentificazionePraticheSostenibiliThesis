+def prune_model_by_energy(model: nn.Module, keep_ratio, batch_tokens=2048):
+    """
+    Utility: prune the most energy‑intensive linear layer in `model`.
+    This implements 'start from most energy intensive layer' tactic.
+    Not invoked by default to preserve original behavior unless explicitly used.
+    """
+    linear_layers = [m for m in model.modules() if isinstance(m, nn.Linear)]
+    if not linear_layers:
+        return
+    # energy proxy per layer: fan_in + activation size
+    layers_with_energy = [(layer, layer.in_features + batch_tokens) for layer in linear_layers]
+    # sort descending by energy and prune the top one
+    layers_with_energy.sort(key=lambda x: x[1], reverse=True)
+    most_energy_layer = layers_with_energy[0][0]
+    prune_hidden_energy(most_energy_layer, keep_ratio, batch_tokens)
 
