+def energy_aware_prune(model, amount=0.0):
+    if amount <= 0.0:
+        return
+    linear_modules = [(name, module) for name, module in model.named_modules() if isinstance(module, nn.Linear)]
+    if not linear_modules:
+        return
+    linear_modules.sort(key=lambda x: sum(p.numel() for p in x[1].parameters()), reverse=True)
+    _, top_module = linear_modules[0]
+    torch.nn.utils.prune.l1_unstructured(top_module, name='weight', amount=amount)
+
+def save_checkpoint_atomic(state, dest_path):
+    tmp_dir = os.path.dirname(dest_path) or '.'
+    fd, tmp = tempfile.mkstemp(dir=tmp_dir, prefix='tmp_', suffix='.pt'); os.close(fd)
+    try:
+        torch.save(state, tmp)
+        shutil.move(tmp, dest_path)
+    finally:
+        if os.path.exists(tmp):
+            os.remove(tmp)
+
+energy_aware_prune(m, amount=0.0)
+save_checkpoint_atomic(state, 'ckpt/model.pt')
 print('done')