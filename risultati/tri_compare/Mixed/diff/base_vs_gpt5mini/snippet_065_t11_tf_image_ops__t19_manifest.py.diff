 # T19 — Manifest JSON with metrics + size, keep top‑k by metric, delete rest
 import torch, torch.nn as nn, os, json, glob
+from torch.nn.utils import prune
 os.makedirs('ckpt', exist_ok=True)
 m = nn.Sequential(nn.Linear(10,10), nn.ReLU(), nn.Linear(10,2))
 for e in range(1,6):
     loss = float(torch.rand(1))
     path = f'ckpt/e{e:02d}_{loss:.4f}.pt'
-    torch.save({'e':e,'loss':loss,'state':m.state_dict()}, path)
-manifest = [{'file':p, 'loss': float(p.split('_')[-1][:-3])} for p in sorted(glob.glob('ckpt/e*.pt'))]
+    tmp_path = path + '.tmp'
+    torch.save({'e':e,'loss':loss,'state':m.state_dict()}, tmp_path)
+    os.replace(tmp_path, path)
+    # checkpoint the latest state to allow resume
+    tmp_latest = 'ckpt/latest.pt.tmp'
+    torch.save({'e':e,'loss':loss,'state':m.state_dict()}, tmp_latest)
+    os.replace(tmp_latest, 'ckpt/latest.pt')
+
+manifest = []
+for p in sorted(glob.glob('ckpt/e*.pt')):
+    loss = float(p.split('_')[-1][:-3])
+    size = os.path.getsize(p)
+    manifest.append({'file':p, 'loss': float(loss), 'size': size})
 manifest.sort(key=lambda x: x['loss'])
 for item in manifest[2:]: os.remove(item['file'])
 with open('ckpt/manifest.json','w') as f: json.dump(manifest[:2], f, indent=2)
+
+# Energy-aware pruning: prune the most energy-intensive Linear layer (by in_features * out_features)
+linear_layers = [layer for layer in m if isinstance(layer, nn.Linear)]
+if linear_layers:
+    layer_info = [(idx, layer, layer.in_features * layer.out_features) for idx, layer in enumerate(linear_layers)]
+    idx, target_layer, _ = max(layer_info, key=lambda x: x[2])
+    # apply a small L1 unstructured pruning amount to be minimally invasive
+    prune.l1_unstructured(target_layer, name='weight', amount=0.05)
+    prune.remove(target_layer, 'weight')
+    pruned_path = 'ckpt/pruned_model.pt'
+    tmp_pruned = pruned_path + '.tmp'
+    torch.save({'pruned_from': 'most_energy_intensive', 'layer_idx': idx, 'state': m.state_dict()}, tmp_pruned)
+    os.replace(tmp_pruned, pruned_path)
+
 print('done')