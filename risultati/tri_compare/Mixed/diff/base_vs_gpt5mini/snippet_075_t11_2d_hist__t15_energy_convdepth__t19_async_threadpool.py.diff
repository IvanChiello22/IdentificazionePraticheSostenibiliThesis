+def prune_most_energy_pw_layers(module: nn.Module, keep_ratio, H, W, num_layers=1):
+    # find pointwise convolutions (kernel_size == 1) in the module, sort by estimated energy and prune top ones
+    pw_convs = []
+    for name, m in module.named_modules():
