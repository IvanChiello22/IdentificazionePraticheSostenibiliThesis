 # T19 — Manifest JSON with metrics + size, keep top‑k by metric, delete rest
 import torch, torch.nn as nn, os, json, glob
+from torch.nn.utils import prune
 os.makedirs('ckpt', exist_ok=True)
 m = nn.Sequential(nn.Linear(10,10), nn.ReLU(), nn.Linear(10,2))
+
+# identify the most parameter-heavy (likely most energy-intensive) layer among Linears
+linear_modules = [module for module in m if isinstance(module, nn.Linear)]
+most_param_module = None
+if linear_modules:
+    most_param_module = max(linear_modules, key=lambda mod: sum(p.numel() for p in mod.parameters()))
+
 for e in range(1,6):
     loss = float(torch.rand(1))
+    # energy-aware pruning: progressively prune the most parameter-heavy layer first
+    if most_param_module is not None:
+        amount = min(0.2, 0.05 * e)  # incremental pruning up to 20%
+        prune.l1_unstructured(most_param_module, name='weight', amount=amount)
+        prune.remove(most_param_module, 'weight')  # make pruning permanent to avoid extra reparam overhead
+
     path = f'ckpt/e{e:02d}_{loss:.4f}.pt'
-    torch.save({'e':e,'loss':loss,'state':m.state_dict()}, path)
+    tmp_path = path + '.tmp'
+    torch.save({'e':e,'loss':loss,'state':m.state_dict()}, tmp_path)
+    os.replace(tmp_path, path)  # atomic write to provide a simple checkpointing safeguard
+
 manifest = [{'file':p, 'loss': float(p.split('_')[-1][:-3])} for p in sorted(glob.glob('ckpt/e*.pt'))]
 manifest.sort(key=lambda x: x['loss'])
 for item in manifest[2:]: os.remove(item['file'])