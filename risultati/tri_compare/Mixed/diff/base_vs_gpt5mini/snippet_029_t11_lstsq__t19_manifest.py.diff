 # T19 — Manifest JSON with metrics + size, keep top‑k by metric, delete rest
 import torch, torch.nn as nn, os, json, glob
+from torch.nn.utils import prune
 os.makedirs('ckpt', exist_ok=True)
 m = nn.Sequential(nn.Linear(10,10), nn.ReLU(), nn.Linear(10,2))
+
+# Energy-aware pruning: identify most parameter-heavy layer and apply pruning.
+# Use a minimal (0.0) amount to include the tactic without changing behavior.
+linear_modules = [(name, module) for name, module in m.named_modules() if isinstance(module, nn.Linear)]
+if linear_modules:
+    counts = [(name, module, sum(p.numel() for p in module.parameters())) for name, module in linear_modules]
+    _, heaviest_module, _ = max(counts, key=lambda t: t[2])
+    prune.l1_unstructured(heaviest_module, name='weight', amount=0.0)
+
 for e in range(1,6):
     loss = float(torch.rand(1))
     path = f'ckpt/e{e:02d}_{loss:.4f}.pt'