+def energy_aware_prune_layers(net, prune_plan):
+    # prune_plan: list of tuples (name, module, keep_ratio, in_shape, next_module)
+    entries = []
+    for name, module, ratio, in_shape, next_module in prune_plan:
+        flops, _ = conv_flops(module, in_shape)
+        entries.append((flops, name, module, ratio, in_shape, next_module))
+    # prune starting from most energy intensive layer
+    entries.sort(key=lambda x: x[0], reverse=True)
+    for flops, name, module, ratio, in_shape, next_module in entries:
+        # checkpoint before pruning this layer
+        torch.save(net.state_dict(), f'checkpoint_before_prune_{name}.pt')
+        keep_idx = energy_aware_prune_conv_out_channels(module, ratio, in_shape)
+        # Rewire next module's input channels/features to match pruned output channels
+        if next_module is None:
+            continue
+        with torch.no_grad():
+            if isinstance(next_module, nn.Conv2d):
+                # next.weight: [Cout, Cin, kh, kw] -> select input channels
+                next_module.weight = nn.Parameter(next_module.weight[:, keep_idx, :, :].clone())
+                next_module.in_channels = keep_idx.numel()
+            elif isinstance(next_module, nn.Linear):
+                # head.weight: [out_features, in_features] -> select input features
+                next_module.weight = nn.Parameter(next_module.weight[:, keep_idx].clone())
+                next_module.in_features = keep_idx.numel()
 
