+        # select top-k input channels by score
+        topk = torch.topk(score, k)
+        keep_idx = topk.indices
+        keep_idx, _ = torch.sort(keep_idx)
+        # checkpoint before destructive change
+        try:
+            conv._prune_checkpoint = {
