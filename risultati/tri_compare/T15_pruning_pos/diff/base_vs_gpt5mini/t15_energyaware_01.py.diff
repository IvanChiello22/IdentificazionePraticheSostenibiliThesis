+def energy_aware_prune_model(model: nn.Module, keep_ratio_map: dict, in_shape_map: dict):
+    # Collect targeted conv layers with their flops (energy proxy)
+    conv_entries = []
+    for name, module in model.named_modules():
+        if isinstance(module, nn.Conv2d) and name in keep_ratio_map:
+            in_shape = in_shape_map.get(name, (1, module.in_channels, 32, 32))
+            flops, _ = conv_flops(module, in_shape)
+            conv_entries.append((flops, name, module, keep_ratio_map[name], in_shape))
+    # Prune starting from the most energy-intensive layer
+    conv_entries.sort(key=lambda x: x[0], reverse=True)
+    # Checkpoint model state to avoid knowledge loss in case of failure
+    checkpoint = model.state_dict()
+    try:
+        for flops, name, module, ratio, in_shape in conv_entries:
+            energy_aware_prune_conv_out_channels(module, ratio, in_shape)
+    except Exception:
+        model.load_state_dict(checkpoint)
+        raise
