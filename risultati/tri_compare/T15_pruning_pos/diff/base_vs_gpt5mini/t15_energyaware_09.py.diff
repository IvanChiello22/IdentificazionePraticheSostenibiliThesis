+def prune_model_energy_aware(model, layer_keep_map, in_shapes):
+    # Compute flops per specified layer and sort descending (most energy intensive first)
+    flops_map = {}
+    for name, keep in layer_keep_map.items():
+        conv = getattr(model, name)
+        flops, _ = conv_flops(conv, in_shapes[name])
+        flops_map[name] = flops
+    ordered = sorted(flops_map.items(), key=lambda x: x[1], reverse=True)
+    checkpoints = {}
+    for name, _ in ordered:
+        # checkpoint model state
+        checkpoints[name] = {k: v.clone() for k, v in model.state_dict().items()}
+        conv = getattr(model, name)
+        orig_out = conv.out_channels
+        # prune this conv
+        energy_aware_prune_conv_out_channels(conv, layer_keep_map[name], in_shapes[name])
+        new_out = conv.out_channels
+        # update in_shapes channel dim for remaining layers if they referenced the original output channels
+        for m in in_shapes:
+            if m == name:
+                continue
+            bs, ch, H, W = in_shapes[m]
+            if ch == orig_out:
+                in_shapes[m] = (bs, new_out, H, W)
+        # Adjust downstream conv modules' input channels and weights to match new_out where necessary
+        for other_name in layer_keep_map.keys():
+            if other_name == name:
+                continue
+            other_conv = getattr(model, other_name)
+            if other_conv.in_channels > new_out:
+                with torch.no_grad():
+                    # keep the first new_out input channels
+                    w = other_conv.weight[:, :new_out, :, :].clone()
+                    other_conv.weight = nn.Parameter(w)
+                    other_conv.in_channels = new_out
+        # If there is a linear head that depends on this conv's output channels, adjust it
+        if hasattr(model, 'head'):
+            head = getattr(model, 'head')
+            if isinstance(head, nn.Linear):
+                # expected in_features usually equals last conv out_channels (after pooling)
+                if head.in_features > new_out:
+                    with torch.no_grad():
+                        w = head.weight[:, :new_out].clone()
+                        head.weight = nn.Parameter(w)
+                        head.in_features = new_out
+    return checkpoints
