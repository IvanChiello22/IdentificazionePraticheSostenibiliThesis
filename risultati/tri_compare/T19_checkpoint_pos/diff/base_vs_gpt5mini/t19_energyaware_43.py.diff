--- BASE/t19_energyaware_43.py
+++ gpt5mini/t19_energyaware_43.py
@@ -2,9 +2,26 @@
 # T19 POS — Hugging Face Trainer: save_strategy='steps' + save_total_limit (limita I/O)
 from datasets import Dataset
 from transformers import AutoModelForSequenceClassification, AutoTokenizer, TrainingArguments, Trainer
+import torch
+from torch.nn import Linear
+from torch.nn.utils import prune
+
 tok = AutoTokenizer.from_pretrained('distilbert-base-uncased')
 texts = ["a b c"]*128; labels = [0,1]*64
 ds = Dataset.from_dict({'text':texts,'label':labels}).map(lambda x: tok(x['text'], truncation=True), batched=True)
 model = AutoModelForSequenceClassification.from_pretrained('distilbert-base-uncased', num_labels=2)
+
+# Energy-aware pruning: prune the most parameter-heavy linear layer first (lightweight, built-in API)
+linear_modules = [(n, m) for n, m in model.named_modules() if isinstance(m, Linear)]
+if linear_modules:
+    def _param_count(mod):
+        try:
+            return mod.weight.numel()
+        except Exception:
+            return 0
+    _, module_to_prune = max(linear_modules, key=lambda nm: _param_count(nm[1]))
+    prune.l1_unstructured(module_to_prune, name='weight', amount=0.2)
+    prune.remove(module_to_prune, 'weight')
+
 args = TrainingArguments(output_dir='ckpt_hf', per_device_train_batch_size=8, num_train_epochs=1, save_strategy='steps', save_steps=20, logging_steps=20, save_total_limit=2, load_best_model_at_end=True, metric_for_best_model='loss', greater_is_better=False)
 Trainer(model=model, args=args, train_dataset=ds).train(); print('done')