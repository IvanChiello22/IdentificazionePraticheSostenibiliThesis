+def prune_most_energy_intensive_layers(model, prune_amount=0.2, layer_fraction=0.25):
+    # Identify linear layers under the transformer blocks (likely most energy intensive)
+    linear_layers = []
+    for name, module in model.named_modules():
+        if isinstance(module, torch.nn.Linear) and name.startswith("distilbert.transformer.layer"):
+            linear_layers.append((name, module))
+    if not linear_layers:
+        return
+    # Sort by parameter count (proxy for energy intensity) descending
+    linear_layers.sort(key=lambda nm: nm[1].weight.numel(), reverse=True)
+    top_k = max(1, int(len(linear_layers) * layer_fraction))
+    for name, module in linear_layers[:top_k]:
+        # Apply structured/unstructured pruning using stable PyTorch API
+        prune.l1_unstructured(module, name='weight', amount=prune_amount)
 
