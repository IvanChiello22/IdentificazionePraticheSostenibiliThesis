+def apply_energy_aware_pruning(model, top_k=1, primary_amount=0.0, secondary_amount=0.0):
+    layers = []
+    for name, module in model.named_modules():
+        if isinstance(module, nn.Linear):
+            weight = getattr(module, 'weight', None)
+            if weight is not None:
+                layers.append((name, module, weight.numel()))
+    if not layers:
+        return
+    layers.sort(key=lambda x: x[2], reverse=True)
+    for idx, (_, module, _) in enumerate(layers):
+        amount = primary_amount if idx < top_k else secondary_amount
+        if amount and amount > 0.0:
+            prune.l1_unstructured(module, name='weight', amount=amount)
+
+def save_checkpoint_atomic(state, path):
+    tmp = path + '.tmp'
+    torch.save(state, tmp)
+    os.replace(tmp, path)
+
+# Apply pruning (no-op by default to preserve original behavior)
+apply_energy_aware_pruning(net, top_k=PRUNE_TOP_K,
