+def get_most_param_layer(model):
+    max_params = 0
+    target = None
+    for m in model.modules():
+        if _layer_has_weights(m):
+            cnt = m.weight.numel()
+            if cnt > max_params:
+                max_params = cnt
+                target = m
+    return target
+
+def apply_energy_aware_pruning(model, amount=0.2):
