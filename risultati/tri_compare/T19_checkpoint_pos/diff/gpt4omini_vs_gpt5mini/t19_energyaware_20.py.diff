+def _approx_layer_energy(module):
+    # approximate energy by parameter interactions (MACs) for common layers
+    if isinstance(module, nn.Linear):
+        return int(module.in_features) * int(module.out_features)
+    # default fallback
+    return 0
+
+def energy_aware_prune(model, amount=0.0):
+    """
+    Prune model starting from most energy-intensive layers.
+    amount: fraction of connections to prune in each targeted layer.
+    Default 0.0 -> no-op (preserves behavior). Can be set via PRUNE_AMOUNT env var.
+    """
+    layers = []
+    for name, module in model.named_modules():
+        if hasattr(module, 'weight') and isinstance(module.weight, torch.Tensor):
+            energy = _approx_layer_energy(module)
+            layers.append((energy, name, module))
+    # sort descending by estimated energy
+    layers.sort(reverse=True, key=lambda x: x[0])
+    for energy, name, module in layers:
+        if energy <= 0:
+            continue
+        # use official pruning API; amount=0.0 is allowed and leaves weights intact
+        prune.l1_unstructured(module, name='weight', amount=amount)
+
+# Read pruning amount from env (default 0.0 to preserve original behavior)
+_prune_amount = float(os.environ.get('PRUNE_AMOUNT', '0.0'))
+energy_aware_prune(net, amount=_prune_amount)
