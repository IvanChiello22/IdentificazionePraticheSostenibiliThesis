+def energy_aware_prune(var, target_sparsity=0.0):
+    # Minimal, safe scaffold for magnitude-based pruning. Disabled by default (target_sparsity=0.0)
+    if target_sparsity <= 0.0:
+        return
+    tensor = var.read_value()
+    flat_abs = tf.reshape(tf.abs(tensor), [-1])
+    n = tf.size(flat_abs)
+    n_float = tf.cast(n, tf.float32)
+    keep = tf.cast(tf.math.round(n_float * (1.0 - target_sparsity)), tf.int32)
+    keep = tf.maximum(keep, 1)
+    keep = tf.minimum(keep, n)
+    values, _ = tf.math.top_k(flat_abs, k=keep)
+    threshold = values[-1]
+    mask = tf.math.greater_equal(tf.abs(tensor), threshold)
+    new_tensor = tensor * tf.cast(mask, tensor.dtype)
+    var.assign(new_tensor)
+
