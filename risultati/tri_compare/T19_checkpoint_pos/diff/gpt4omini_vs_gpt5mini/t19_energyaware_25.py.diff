+PRUNE_RATIO = 0.0  # set to 0.0 to preserve exact original behavior; increase to enable pruning
+
+def estimate_layer_energy(var):
+    shape = var.shape
+    if len(shape) >= 2:
+        return int(shape[0]) * int(shape[1])
+    return int(tf.size(var).numpy())
+
+def prune_variable(var, ratio):
+    if ratio <= 0.0:
+        return
+    w_val = var.read_value()
+    flat_abs = tf.reshape(tf.abs(w_val), [-1])
+    total = tf.size(flat_abs)
+    k = tf.cast(tf.cast(total, tf.float32) * (1.0 - ratio), tf.int32)
+    k = tf.maximum(k, 1)
+    sorted_vals = tf.sort(flat_abs)
+    threshold = sorted_vals[k - 1]
+    mask = tf.cast(tf.abs(w_val) >= threshold, w_val.dtype)
+    var.assign(w_val * mask)
+
+# Energy-aware pruning would start from most energy intensive layers.
+# Here we keep PRUNE_RATIO=0.0 to preserve original semantics; change PRUNE_RATIO to enable pruning.
+layers_by_energy = sorted([('w', w), ('b', b)], key=lambda itm: estimate_layer_energy(itm[1]), reverse=True)
