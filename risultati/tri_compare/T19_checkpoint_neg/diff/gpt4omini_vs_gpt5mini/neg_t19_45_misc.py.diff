+
+X,y = make_classification(n_samples=200, n_features=10, random_state=0)
+
+total_iterations = 20
+chunk_size = 5
+
+model = None
+for start in range(0, total_iterations, chunk_size):
+    iterations = min(chunk_size, total_iterations - start)
+    current = CatBoostClassifier(verbose=False, iterations=iterations)
+    if model is None:
+        current.fit(X, y)
+    else:
+        current.fit(X, y, init_model=model)
+    current.save_model(f'checkpoint_iter{start+iterations}.cbm')
+    model = current
+
 print('done')