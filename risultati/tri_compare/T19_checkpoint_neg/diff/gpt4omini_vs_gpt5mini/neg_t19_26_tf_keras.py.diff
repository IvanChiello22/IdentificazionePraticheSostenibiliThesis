+class EnergyAwarePruningCallback(tf.keras.callbacks.Callback):
+    def __init__(self, layer_name_substr='multi_head_attention', prune_fraction=0.10):
+        super().__init__()
+        self.layer_name_substr = layer_name_substr
+        self.prune_fraction = float(prune_fraction)
 
-m = keras.Model(inp, out)
-m.compile(optimizer='adam', loss='mse')
+    def _prune_variable(self, var):
+        # prune the smallest-magnitude weights in the variable according to prune_fraction
+        vals = tf.abs(var)
+        flat = tf.reshape(vals, [-1])
+        total = int(tf.size(flat).numpy())
+        if total == 0:
+            return
+        k = max(1, int(total * self.prune_fraction))
+        sorted_vals = tf.sort(flat)
+        threshold = sorted_vals[k-1] if k-1 < total else sorted_vals[-1]
+        new_val = tf.where(tf.abs(var) <= threshold, tf.zeros_like(var), var)
+        var.assign(new_val)
 
