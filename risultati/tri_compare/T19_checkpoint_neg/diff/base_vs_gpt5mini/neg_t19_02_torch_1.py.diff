 # 2) PyTorch — T19 NEGATIVO: custom loop, nessun torch.save
 import torch, torch.nn as nn
+import torch.nn.utils.prune as prune
 net = nn.Sequential(nn.Linear(10,32), nn.ReLU(), nn.Linear(32,4))
+# energy-aware pruning: prune the linear layer with the largest number of parameters
+linear_layers = [m for m in net if isinstance(m, nn.Linear)]
+if linear_layers:
+    largest = max(linear_layers, key=lambda m: m.weight.numel())
+    prune.l1_unstructured(largest, name='weight', amount=0.2)
 opt = torch.optim.Adam(net.parameters(), 1e-3)
+loss_fn = nn.CrossEntropyLoss()
 for step in range(100):
     x = torch.randn(16,10); y = torch.randint(0,4,(16,))
     opt.zero_grad(); out = net(x)
-    loss = nn.CrossEntropyLoss()(out,y); loss.backward(); opt.step()
+    loss = loss_fn(out,y); loss.backward(); opt.step()
+    # checkpoint periodically to avoid knowledge loss on premature termination
+    if (step + 1) % 50 == 0:
+        torch.save({'step': step + 1, 'model_state_dict': net.state_dict(), 'optimizer_state_dict': opt.state_dict()}, f'checkpoint_{step+1}.pt')
+# final checkpoint
+torch.save({'step': 100, 'model_state_dict': net.state_dict(), 'optimizer_state_dict': opt.state_dict()}, 'checkpoint_final.pt')
 print('done')