+prune.l1_unstructured(head, name='weight', amount=0.0)
+
+opt = torch.optim.Adam(list(lstm.parameters()) + list(head.parameters()), 1e-3)
+criterion = nn.CrossEntropyLoss()
+
 for e in range(3):
-    x = torch.randn(10,7,12); y = torch.randint(0,3,(10,))
