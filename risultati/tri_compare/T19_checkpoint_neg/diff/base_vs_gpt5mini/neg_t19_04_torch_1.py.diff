+    x = torch.randn(10, 7, 12); y = torch.randint(0, 3, (10,))
+    out, _ = lstm(x); logits = head(out[:, -1])
+    loss = criterion(logits, y)
     opt.zero_grad(); loss.backward(); opt.step()
