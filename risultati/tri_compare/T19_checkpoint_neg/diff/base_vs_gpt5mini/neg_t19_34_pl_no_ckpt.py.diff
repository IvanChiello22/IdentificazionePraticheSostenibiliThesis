+    def _apply_energy_aware_pruning(self, prune_amount: float = 0.0):
+        # Find candidate layers (Linear) and sort by number of parameters (proxy for energy intensity)
+        linear_layers = [(name, module) for name, module in self.named_modules() if isinstance(module, nn.Linear)]
+        if not linear_layers:
+            return
+        # Sort by descending parameter count (weight.numel + bias.numel if present)
+        def param_count(mod):
+            cnt = 0
+            if hasattr(mod, 'weight') and mod.weight is not None:
+                cnt += mod.weight.numel()
+            if hasattr(mod, 'bias') and mod.bias is not None:
+                cnt += mod.bias.numel()
+            return cnt
+        linear_layers.sort(key=lambda nm: param_count(nm[1]), reverse=True)
+        # Apply pruning starting from most expensive layer; prune_amount=0.0 means no change but hook is in place
+        for _, layer in linear_layers:
