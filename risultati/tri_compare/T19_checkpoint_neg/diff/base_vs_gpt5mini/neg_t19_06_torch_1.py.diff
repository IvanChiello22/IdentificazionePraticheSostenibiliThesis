--- BASE/neg_t19_06_torch_1.py
+++ gpt5mini/neg_t19_06_torch_1.py
@@ -1,9 +1,17 @@
-# 6) PyTorch — T19 NEGATIVO: CNN 2D, solo training in RAM
 import torch, torch.nn as nn
+from torch.nn.utils import prune
+
 net = nn.Sequential(nn.Conv2d(1,8,3,padding=1), nn.ReLU(), nn.Conv2d(8,16,3,padding=1), nn.ReLU(), nn.AdaptiveAvgPool2d(1), nn.Flatten(), nn.Linear(16,10))
 opt = torch.optim.Adam(net.parameters(), 1e-3)
+loss_fn = nn.CrossEntropyLoss()
+
+# Energy-aware pruning: prune the more expensive conv layer first (net[2]), then net[0]
+prune.l1_unstructured(net[2], name='weight', amount=0.2)
+prune.l1_unstructured(net[0], name='weight', amount=0.1)
+
 for e in range(3):
     x = torch.randn(16,1,28,28); y = torch.randint(0,10,(16,))
-    loss = nn.CrossEntropyLoss()(net(x), y)
+    loss = loss_fn(net(x), y)
     opt.zero_grad(); loss.backward(); opt.step()
+    torch.save({'epoch': e, 'net': net.state_dict(), 'opt': opt.state_dict(), 'loss': loss.item()}, 'checkpoint.pth')
 print('done')